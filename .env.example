OPENAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PUBLIC_BASE_URL=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
LOCAL_API_TOKEN=
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_VOICE=marin
CALLER_NAME=Alex
# Leave empty unless explicitly approved for disclosure on calls.
CALLBACK_NUMBER=
DATABASE_PATH=data/calls.sqlite3
# Enable authenticated Streamable HTTP MCP on the same FastAPI application.
MCP_ENABLED=false
OAUTH_DATABASE_PATH=data/oauth.sqlite3
# Requires Live read/write AND Responses write permission on the OpenAI key.
LIVE_TOOLS_ENABLED=false
OPENAI_BACKEND_MODEL=gpt-6-luna
# Optional push destination. Receives new events only after initial configuration.
WEBHOOK_URL=
# Generate a separate random signing secret; never use provider keys here.
WEBHOOK_SECRET=
# Incoming calls are opt-in. Configure your Twilio number only after testing.
INBOUND_ENABLED=false
INBOUND_MODE=messages
INBOUND_MAX_DURATION_MINUTES=5
INBOUND_MAX_CALLS_PER_HOUR=10
# Requires a verified live supervisor subscription for automatic help.
SUPERVISOR_WAIT_SECONDS=45
# Opt in only to ordinary appointments within your own standing authorization.
INBOUND_BOOKING_ALLOWED=false
# Optional private Codex CLI worker, logged in with ChatGPT on the service host.
# Separate from the API-billed voice/Responses backend above. No API fallback.
SUBSCRIPTION_LOOKUP_ENABLED=false
SUBSCRIPTION_LOOKUP_TIMEOUT_SECONDS=20
# Optional one-attempt screened owner connection. The model never chooses a number.
OWNER_TRANSFER_ENABLED=false
OWNER_TRANSFER_NUMBER=
OWNER_TRANSFER_RING_SECONDS=20
# Optional conference handoff: 1 accepts with Luna coaching, 3 captions only, 2 declines.
# Both accepted modes stream dedicated transcription; extra provider charges apply.
OWNER_OBSERVATION_ENABLED=false
OPENAI_TRANSCRIPTION_MODEL=gpt-live-transcribe
